# Copy this file to .env and fill in your mail server.
# Gmail: smtp.gmail.com, port 587, and an app password (not your normal password).
# Outlook / Microsoft 365: smtp.office365.com, port 587.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
